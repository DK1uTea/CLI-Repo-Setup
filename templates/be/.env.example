# =====================================================
# {{projectNameTitle}} Backend API - Environment Variables
# =====================================================
NODE_ENV=development
API_PORT=3000
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Seeding
SEED_TENANT_NAME=Default Tenant
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_PASSWORD=Admin@123456

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_change_in_production
REFRESH_TOKEN_TTL_DAYS=7

# ===============================================================
# Microsoft Entra (Azure AD) SSO (Optional)
# ===============================================================
# Application (client) ID from the Azure App Registration. Leave empty to disable SSO.
ENTRA_CLIENT_ID=
ENTRA_JWKS_URI=https://login.microsoftonline.com/common/discovery/v2.0/keys
# JSON array mapping each allowed Microsoft Entra tenant id (tid) to an internal tenant id.
# ENTRA_TENANT_MAPPINGS=[{"tid":"<entra-tenant-id>","tenantId":"tenant-a"}]
ENTRA_TENANT_MAPPINGS=
# Comma-separated email domains whose new SSO users are auto-approved. Example: company.com
ENTRA_AUTO_APPROVE_DOMAINS=

# ===============================================================
# Redis Cache
# ===============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX={{sanitizedProjectName}}
REDIS_URL=redis://localhost:6379

# ===============================================================
# Database (PostgreSQL / TimescaleDB)
# ===============================================================
POSTGRES_DB={{projectNameDb}}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123456
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres123456@localhost:5432/{{projectNameDb}}

# ===============================================================
# AWS S3 (Storage)
# ===============================================================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# AWS_S3_BASE_URL=https://your-bucket-name.s3.ap-southeast-1.amazonaws.com
