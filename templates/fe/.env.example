# Copy to `.env` (or `.env.local`) and fill in. Never commit real values.

# --- Backend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_VERSION=
NEXT_PUBLIC_IMAGE_HOST=
NEXT_PUBLIC_VERSION=

# --- Social media ----------------------------------------------------------
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=

# --- reCAPTCHA v3 ----------------------------------------------------------
# The login form waits for this before it will submit.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Double-gated dev/E2E bypass for the backend's score check — see
# src/lib/verify-captcha.ts. Also requires NODE_ENV !== 'production', so setting this
# has no effect in a real deployment. Only ever set it in `.env.local`.
SKIP_CAPTCHA_VERIFICATION=

# --- E2E ---------------------------------------------------------------------
# The whole E2E suite hits the real backend in `NEXT_PUBLIC_API_BASE_URL` — there is no
# mocked mode. Put every value below in `.env.local` (gitignored), never here or in `.env`.
#
# Primary account — required. Everything under e2e/modules/ that signs in uses this
# account, including tests that deliberately submit a wrong password (spends a real
# attempt each time; can lock the account after five in a row — unlock manually).
#
# Its real, stored language preference MUST be German (Settings → Language & Region →
# Deutsch). The login route and the app's own client sync both set the UI locale from
# that real setting on every load, so no cookie a test sets can override an account whose
# preference is English — every module would render (and every assertion would fail) in
# English instead. Set it once through the real Settings page; it is not something the
# test suite can or should force from outside.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Full name as the backend returns it, for tests that assert the derived avatar initials.
E2E_USER_NAME=

# Optional — each block's test is skipped when its values are blank.
# Pre-locked account, for the "account locked" error branch:
E2E_LOCKED_USER_EMAIL=
E2E_LOCKED_USER_PASSWORD=
# Inactive account, for the "account inactive" error branch:
E2E_INACTIVE_USER_EMAIL=
E2E_INACTIVE_USER_PASSWORD=
# Account restricted to specific sidebar modules, for the permission-gating test.
# E2E_RESTRICTED_USER_MODULES is a comma-separated list of MODULES keys from
# e2e/shared/session.ts that this account should see, e.g. "events,userSettings".
E2E_RESTRICTED_USER_EMAIL=
E2E_RESTRICTED_USER_PASSWORD=
E2E_RESTRICTED_USER_MODULES=

# CAM role accounts. The primary E2E account is the Internal Admin equivalent.
E2E_CAM_SALE_EMAIL=
E2E_CAM_SALE_PASSWORD=
E2E_CAM_INSTALLER_EMAIL=
E2E_CAM_INSTALLER_PASSWORD=
E2E_CAM_AGENCY_EMAIL=
E2E_CAM_AGENCY_PASSWORD=
# Explicit opt-in for CAM tests that mutate shared backend records.
E2E_CAM_ALLOW_MUTATIONS=false

# Explicit opt-in for calendar-dashboard tests that create/delete real calendar events.
E2E_CALENDAR_ALLOW_MUTATIONS=false

# Override the URL Playwright targets (defaults to http://localhost:3000).
PLAYWRIGHT_BASE_URL=
