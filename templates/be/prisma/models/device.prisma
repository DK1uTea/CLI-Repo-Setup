enum DeviceProtocol {
  GT06
  CANTRACK
}

enum DeviceRegistrationStatus {
  PENDING_ACTIVATION
  WHITELISTED
  SUSPENDED
}

enum DeviceType {
  COOLER
  VENDING_MACHINE
  DISPENSER
}

model Device {
  id                   String         @id @default(cuid()) @db.VarChar(30)
  imei                 String         @db.VarChar(20) @unique
  name                 String         @db.VarChar(100)
  tenantId             String         @db.VarChar(30) @map("tenant_id")
  internalId           String?        @db.VarChar(100) @map("internal_id")
  type                 DeviceType     @map("type")
  avatar               String?        @db.VarChar(500) @map("avatar")
  protocol             DeviceProtocol @default(GT06)
  registrationStatus   DeviceRegistrationStatus @default(PENDING_ACTIVATION) @map("registration_status")
  firstSeenAt          DateTime?                @map("first_seen_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status              DeviceStatus?
  positions           Position[]
  events              Event[]
  commands            DeviceCommand[]
  commandLogs         DeviceCommandLog[]
  geofenceAssignments GeofenceAssignment[]
  geofenceStates      GeofenceState[]

  @@index([tenantId], map: "idx_pt_devices_tenant")
  @@index([imei], map: "idx_pt_devices_imei")
  @@index([registrationStatus], map: "idx_pt_devices_registration_status")
  @@index([tenantId, registrationStatus], map: "idx_pt_devices_tenant_status")
  @@index([type], map: "idx_pt_devices_type")
  @@unique([tenantId, internalId], map: "idx_pt_devices_tenant_internal_id")

  @@map("pt_devices")
}

model DeviceStatus {
  id             String    @id @default(cuid()) @db.VarChar(30)
  deviceId       String    @unique @map("device_id") @db.VarChar(30)
  tenantId       String    @map("tenant_id") @db.VarChar(30)

  // Telemetry hiện tại
  battery        Int?      @db.SmallInt
  batteryVoltage Decimal?  @map("battery_voltage") @db.Decimal(6, 3)
  gsmSignal      Int?      @map("gsm_signal") @db.SmallInt
  lastSeenAt     DateTime? @map("last_seen_at")

  // Position hiện tại (denormalized từ pt_positions để tránh scan hypertable)
  lastAddress    String?   @map("last_address") @db.VarChar(500)
  lastLatitude   Decimal?  @map("last_latitude") @db.Decimal(10, 7)
  lastLongitude  Decimal?  @map("last_longitude") @db.Decimal(10, 7)
  lastSpeedKph   Float?    @map("last_speed_kph")
  lastHeading    Int?      @map("last_heading")
  lastGpsValid   Boolean?  @map("last_gps_valid")
  lastDeviceTime DateTime? @map("last_device_time")
  // Auto-populated bởi trigger trg_pt_device_status_geom từ last_latitude/last_longitude
  lastGeom       Unsupported("geography(Point,4326)")? @map("last_geom")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_pt_device_status_tenant")
  @@index([lastSeenAt], map: "idx_pt_device_status_last_seen")
  // @@index([lastGeom], type: Gist, map: "idx_pt_device_status_geom_gist")
  @@map("pt_device_status")
}
