{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/{{sanitizedProjectName}}/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/{{sanitizedProjectName}}/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/{{sanitizedProjectName}}",
  "projects": {
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "layer-data": {
      "type": "library",
      "root": "libs/layer-data",
      "entryFile": "index",
      "sourceRoot": "libs/layer-data/src",
      "compilerOptions": {
        "tsConfigPath": "libs/layer-data/tsconfig.lib.json"
      }
    },
    "{{sanitizedProjectName}}": {
      "type": "application",
      "root": "apps/{{sanitizedProjectName}}",
      "entryFile": "main",
      "sourceRoot": "apps/{{sanitizedProjectName}}/src",
      "compilerOptions": {
        "tsConfigPath": "apps/{{sanitizedProjectName}}/tsconfig.app.json"
      }
    },
    "tcp-server": {
      "type": "application",
      "root": "apps/tcp-server",
      "entryFile": "main",
      "sourceRoot": "apps/tcp-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tcp-server/tsconfig.app.json"
      }
    },
    "third-party": {
      "type": "library",
      "root": "libs/third-party",
      "entryFile": "index",
      "sourceRoot": "libs/third-party/src",
      "compilerOptions": {
        "tsConfigPath": "libs/third-party/tsconfig.lib.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    }
  }
}
