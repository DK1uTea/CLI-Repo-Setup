# =====================================================
# ProTrack Backend API - Environment Variables
# =====================================================
NODE_ENV=development
API_PORT=xxxx
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=http://localhost:3000,https://app.yourdomain.com

# Seeding
SEED_TENANT_NAME=xxxxxxxxxx
SEED_SUPER_ADMIN_EMAIL=xxxxx@xxxx.xx
SEED_SUPER_ADMIN_NAME=xxxxxxxxxxxxxxxxxx
SEED_SUPER_ADMIN_PASSWORD=xxxxxxxxxxxx

# JWT
JWT_SECRET=xxxx
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=xxxx
REFRESH_TOKEN_TTL_DAYS=xxxx

# ===============================================================
# Microsoft Entra (Azure AD) SSO
# ===============================================================
# Application (client) ID from the Azure App Registration. Leave empty to disable SSO.
ENTRA_CLIENT_ID=
# JWKS endpoint. `common` works for a multi-tenant app (Prowerb + Coca-Cola + ...).
ENTRA_JWKS_URI=https://login.microsoftonline.com/common/discovery/v2.0/keys
# JSON array mapping each allowed Microsoft Entra tenant id (tid) to an internal tenant id.
# Doubles as the allowlist — only tenants listed here may sign in. Seed creates the
# `prowerb` and `coca-cola` tenants (pnpm prisma:seed).
# ENTRA_TENANT_MAPPINGS=[{"tid":"<prowerb-entra-tid>","tenantId":"prowerb"},{"tid":"<ccep-entra-tid>","tenantId":"coca-cola"}]
ENTRA_TENANT_MAPPINGS=
# Comma-separated email domains whose new SSO users are auto-approved (skip the PENDING gate).
# Everyone else still needs manual admin approval. Example: prowerb.de,ccep.com
ENTRA_AUTO_APPROVE_DOMAINS=

# ===============================================================
# ProTrack TCP Server Configuration
# ===============================================================
TCP_PORT_1=5023
TCP_PORT_2=9942
HEALTH_HTTP_PORT=8080

# ===============================================================
# Common Application Settings
# ===============================================================
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX={{sanitizedProjectName}}
REDIS_URL=redis://localhost:6379

# Database
POSTGRES_DB={{projectNameDb}}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxxxxxxxxxx
DB_PORT=5432
DATABASE_URL=postgresql://postgres:xxxxxxxxxxxx@localhost:5432/{{projectNameDb}}

# ===============================================================
# AWS
# ===============================================================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=your-bucket-name
# Optional: override auto-generated base URL, maybe CDN url
# AWS_S3_BASE_URL=https://your-bucket-name.s3.ap-southeast-1.amazonaws.com
