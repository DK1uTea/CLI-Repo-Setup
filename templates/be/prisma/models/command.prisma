enum DeviceCommandType {
  REBOOT
  SET_APN
  SET_REPORT_INTERVAL
  CUSTOM
}

enum DeviceCommandStatus {
  PENDING
  SENT
  ACKED
  FAILED
  TIMEOUT
  CANCELLED
}

enum DeviceCommandStage {
  QUEUED
  SENT
  ACKED
  FAILED
  RETRY
  TIMEOUT
  CANCELLED
}

model DeviceCommand {
  id            String              @id @default(cuid()) @db.VarChar(30)
  tenantId      String              @map("tenant_id") @db.VarChar(30)
  deviceId      String              @map("device_id") @db.VarChar(30)
  commandType   DeviceCommandType   @map("command_type")
  payload       Json?
  status        DeviceCommandStatus @default(PENDING)
  priority      Int                 @default(0)
  scheduledAt   DateTime?           @map("scheduled_at")
  expiresAt     DateTime?           @map("expires_at")
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(3) @map("max_attempts")
  sentAt        DateTime?           @map("sent_at")
  ackedAt       DateTime?           @map("acked_at")
  failedAt      DateTime?           @map("failed_at")
  requestedById String?             @map("requested_by_id") @db.VarChar(30)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device      Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestedBy User?              @relation("RequestedByUser", fields: [requestedById], references: [id], onDelete: SetNull)
  logs        DeviceCommandLog[]

  @@index([tenantId, status, scheduledAt], map: "idx_pt_device_commands_tenant_status_schedule")
  @@index([deviceId, createdAt], map: "idx_pt_device_commands_device_created")
  @@index([status, scheduledAt], map: "idx_pt_device_commands_status_schedule")
  @@index([requestedById], map: "idx_pt_device_commands_requested_by")
  @@map("pt_device_commands")
}

model DeviceCommandLog {
  id        BigInt             @id @default(autoincrement())
  commandId String             @map("command_id") @db.VarChar(30)
  tenantId  String             @map("tenant_id") @db.VarChar(30)
  deviceId  String             @map("device_id") @db.VarChar(30)
  stage     DeviceCommandStage 
  message   String?            @db.VarChar(500)
  meta      Json?
  createdAt DateTime           @default(now()) @map("created_at")

  command DeviceCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device  Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([commandId, createdAt], map: "idx_pt_device_command_logs_command_created")
  @@index([tenantId, createdAt], map: "idx_pt_device_command_logs_tenant_created")
  @@index([deviceId, createdAt], map: "idx_pt_device_command_logs_device_created")
  @@map("pt_device_command_logs")
}
