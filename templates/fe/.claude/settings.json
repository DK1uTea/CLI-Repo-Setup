{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/rules-sync-reminder.mjs"],
            "timeout": 10,
            "statusMessage": "Checking agent rule sync..."
          }
        ]
      }
    ]
  }
}
