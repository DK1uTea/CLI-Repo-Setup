enum GeofenceType {
  CIRCLE
  POLYGON
}

enum GeofenceAssignmentTargetType {
  DEVICE
  TENANT_ALL
}

model Geofence {
  id        String       @id @default(cuid()) @db.VarChar(30)
  tenantId  String       @map("tenant_id") @db.VarChar(30)
  name      String       @db.VarChar(255)
  type      GeofenceType
  centerLat Decimal?     @map("center_lat") @db.Decimal(10, 7)
  centerLng Decimal?     @map("center_lng") @db.Decimal(10, 7)
  radiusM   Float?       @map("radius_m")
  geom      Unsupported("geography(Geometry,4326)") // Circle → Point + radius_m, Polygon → Polygon
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments GeofenceAssignment[]
  states      GeofenceState[]
  events      Event[]

  @@index([tenantId], map: "idx_pt_geofences_tenant")
  @@index([tenantId, isActive], map: "idx_pt_geofences_tenant_active")
  // @@index([geom], type: Gist, map: "idx_pt_geofences_geom_gist")
  @@map("pt_geofences")
}

model GeofenceAssignment {
  id         String                       @id @default(cuid()) @db.VarChar(30)
  tenantId   String                       @map("tenant_id") @db.VarChar(30)
  geofenceId String                       @map("geofence_id") @db.VarChar(30)
  targetType GeofenceAssignmentTargetType @map("target_type")
  deviceId   String?                      @map("device_id") @db.VarChar(30)
  startAt    DateTime?                    @map("start_at")
  endAt      DateTime?                    @map("end_at")
  isActive   Boolean                      @default(true) @map("is_active")
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  device   Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, geofenceId], map: "idx_pt_geofence_assignments_tenant_geofence")
  @@index([targetType, deviceId], map: "idx_pt_geofence_assignments_target")
  @@index([isActive, startAt, endAt], map: "idx_pt_geofence_assignments_active_window")
  @@map("pt_geofence_assignments")
}

model GeofenceState {
  id              String    @id @default(cuid()) @db.VarChar(30)
  tenantId        String    @map("tenant_id") @db.VarChar(30)
  deviceId        String    @map("device_id") @db.VarChar(30)
  geofenceId      String    @map("geofence_id") @db.VarChar(30)
  isInside        Boolean   @map("is_inside")
  enteredAt       DateTime? @map("entered_at")
  exitedAt        DateTime? @map("exited_at")
  lastEvaluatedAt DateTime  @map("last_evaluated_at")
  lastPositionId  BigInt?   @map("last_position_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  geofence     Geofence  @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  lastPosition Position? @relation(fields: [lastPositionId], references: [id], onDelete: SetNull)

  @@unique([deviceId, geofenceId], map: "uq_pt_geofence_states_device_geofence")
  @@index([tenantId, lastEvaluatedAt], map: "idx_pt_geofence_states_tenant_eval")
  @@index([deviceId, lastEvaluatedAt], map: "idx_pt_geofence_states_device_eval")
  @@map("pt_geofence_states")
}
